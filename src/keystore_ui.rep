// QtRO view contract for the keystore UI.
//
// This is one of only TWO .rep files in the wallet stack permitted to carry a password
// parameter — signer_ui is the other, and it takes the password to authorise a signature.
// This one takes it to create, unlock-for-export, re-encrypt or destroy a vault. Every
// wallet .rep must stay free of password parameters, and CI asserts that; the exception
// list is these two, and it is short on purpose.
//
// The QML half and this backend are one trust unit — they share a plugin identity and one
// token — so a password crossing between them is not a boundary crossing.
//
// What is deliberately absent: any property that would PUBLISH a secret. A generated
// mnemonic and an exported vault are returned from a SLOT and held only as long as the
// screen showing them lives. They are not PROPs, because a PROP is cached in the shell
// process and its changes are broadcast to every connected replica.
class KeystoreUi
{
    PROP(QString statusText="Starting" READONLY)
    PROP(QString lastError="" READONLY)
    PROP(bool busy=false READONLY)

    // Accounts and their names. Both come from ungated reads — an account list is not a
    // secret, which is exactly why a wallet may have it and this UI is not special for
    // showing it.
    PROP(QString accountsJson="[]" READONLY)
    PROP(QString labelsJson="{}" READONLY)

    // { kind, identity, approver, custodian } — so the UI can say plainly whether it is
    // in fact the configured custodian, rather than failing mysteriously later.
    PROP(QString identityJson="{}" READONLY)
    PROP(bool isCustodian=false READONLY)

    SLOT(void refresh())

    // Returns the phrase. NOT a property: see the note above.
    SLOT(QString generateMnemonic(int words))
    // Confirm-and-commit. `phrase` is the one just generated and shown.
    SLOT(bool importMnemonic(QString phrase, QString accountPassword))
    SLOT(bool importPrivateKey(QString privHex, QString accountPassword))
    SLOT(bool importVaultJson(QString vaultJson, QString oldPassword, QString newPassword))
    SLOT(bool createAccount(QString accountPassword))

    // Returns the vault JSON for the caller to save. Not a property, same reason.
    SLOT(QString exportVaultJson(QString address, QString password))

    SLOT(bool setLabel(QString address, QString label))
    SLOT(bool changePassword(QString address, QString oldPassword, QString newPassword))
    SLOT(bool deleteAccount(QString address, QString password))
}
